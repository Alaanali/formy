DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=formy
POSTGRES_USER=formy
POSTGRES_PASSWORD=formy
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440

# Broker and cache use separate databases: clearing the cache issues
# FLUSHDB, which on a shared database would drop queued Celery work.
REDIS_URL=redis://127.0.0.1:6390/0
CACHE_URL=redis://127.0.0.1:6390/1

# 32 bytes, base64. Generate one with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Never change it once answers exist -- every stored answer becomes
# unreadable, since a single key seals all of them.
FIELD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Development prints invitation emails to the console. Production requires a
# real relay: EMAIL_HOST is mandatory there, the rest have defaults.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=surveys@example.com

CELERY_BROKER_URL=redis://127.0.0.1:6390/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6390/0
