DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=formy
POSTGRES_USER=formy
POSTGRES_PASSWORD=formy
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440

# Broker and cache use separate databases: clearing the cache issues
# FLUSHDB, which on a shared database would drop queued Celery work.
REDIS_URL=redis://127.0.0.1:6390/0
CACHE_URL=redis://127.0.0.1:6390/1

CELERY_BROKER_URL=redis://127.0.0.1:6390/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6390/0
